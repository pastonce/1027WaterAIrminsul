/asserts/*
!/asserts/对白整合.md
!/asserts/生日贺图/
/asserts/生日贺图/*
!/asserts/生日贺图/信与回复.md

# Secrets and local configuration; the example is safe to publish.
.env
.env.*
!.env.example
.dev.vars
.dev.vars.*
*.local

# Reports and temporary packaging (keep public/ and functions/ tracked).
*.log
*.tsbuildinfo
*.tmp
*.bak
/*.zip
/release/
/releases/
.DS_Store
Thumbs.db
desktop.ini
