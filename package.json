{
  "name": "water-an-irminsul",
  "private": true,
  "version": "0.1.0",
  "type": "module",
  "engines": { "node": ">=22.12.0" },
  "scripts": {
    "dev": "vite --host 127.0.0.1",
    "build": "tsc --noEmit && vite build",
    "preview": "vite preview --host 127.0.0.1",
    "release:audit": "node scripts/audit-release.mjs",
    "typecheck": "tsc --noEmit",
    "prebuild": "npm run assets:dialogues && npm run assets:birthday-mail && npm run assets:startup",
    "assets:startup": "node scripts/prepare-startup-assets.mjs",
    "assets:dialogues": "node --experimental-strip-types scripts/prepare-dialogues.mjs",
    "assets:expressions": "node scripts/prepare-expressions.mjs",
    "assets:music": "node scripts/prepare-music.mjs",
    "assets:sfx": "node scripts/prepare-sfx.mjs",
    "assets:fonts": "python scripts/prepare-fonts.py",
    "test": "vitest run",
    "test:watch": "vitest",
    "test:e2e": "playwright test",
    "assets:background-posters": "node --experimental-strip-types scripts/render-background-posters.mjs",
    "assets:festival-background": "node scripts/derive-festival-background.mjs",
    "assets:e-skill-pattern": "node scripts/prepare-e-skill-pattern.mjs",
    "assets:page-art": "node scripts/prepare-page-assets.mjs",
    "assets:birthday-mail": "node --experimental-strip-types scripts/prepare-birthday-mail.mjs",
    "assets:birthday-art": "node scripts/prepare-birthday-art.mjs",
    "assets:background-audit": "node scripts/audit-background-scenes.mjs",
    "assets:inhabitants": "node scripts/prepare-inhabitant-assets.mjs",
    "assets:inhabitant-posters": "node scripts/render-inhabitant-posters.mjs",
    "assets:hiding-layers": "node scripts/render-hiding-layers.mjs",
    "assets:hiding-calibration": "node scripts/calibrate-hiding-places.mjs",
    "assets:background-supplements": "node scripts/fetch-background-supplements.mjs",
    "assets:verify-player-spine": "node scripts/verify-player-spine.mjs",
    "assets:player-spine-previews": "node scripts/render-player-spine.mjs",
    "assets:extract-player-spine": "node scripts/extract-player-spine.mjs",
    "assets:verify-player-extracted": "node scripts/verify-player-extracted.mjs",
    "assets:player-extracted-previews": "node scripts/render-player-extracted.mjs"
  },
  "dependencies": {
    "gsap": "^3.14.2",
    "react": "^19.2.0",
    "react-dom": "^19.2.0",
    "spine-player-4-0": "npm:@esotericsoftware/spine-player@4.0.31",
    "spine-webgl-4-1": "npm:@esotericsoftware/spine-webgl@4.1.56"
  },
  "devDependencies": {
    "@playwright/test": "^1.56.1",
    "@types/node": "^24.10.0",
    "@types/react": "^19.2.0",
    "@types/react-dom": "^19.2.0",
    "@vitejs/plugin-react": "^5.1.1",
    "typescript": "~5.9.3",
    "vite": "^7.3.1",
    "vitest": "^4.0.18"
  }
}
